# All settings are OPTIONAL. The app runs with zero configuration.

# Sentiment engine: "vader" (default, instant) or "finbert" (heavy, lazy-loaded)
SENTIMENT_ENGINE=vader

# Cache TTL for a full ticker analysis, in seconds
ANALYZE_CACHE_TTL=600

# Per-source fetch timeout, in seconds
SOURCE_TIMEOUT=8

# Optional Reddit API credentials (improves robustness vs. public .json).
# Create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentiment-platform/1.0

# Comma-separated list of disabled sources (e.g. "stocktwits,hackernews")
DISABLED_SOURCES=
