# Keep the build context small and secret-free.
.git
.github
**/.DS_Store
**/*.log

# Secrets and local state: configure via env / --env-file, never bake into the image.
**/.env
**/*.db
**/*.db-wal
**/*.db-shm
backend/data

# Python
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/.pytest_cache
**/.ruff_cache
backend/tests
backend/scripts

# Node / frontend build output (rebuilt inside the image)
**/node_modules
frontend/dist
frontend/e2e
frontend/test-results
